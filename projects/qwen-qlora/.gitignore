# Dataset (regenerate with scripts/generate_data.py + scripts/prepare_data.py)
/data/*
!/data/README.md
!/data/samples/
# Test split + manifest committed on purpose: reference data for the
# llm-eval-harness port validation (see both projects' READMEs).
!/data/test.jsonl
!/data/split.json

# Generated project outputs
/artifacts/
/models/
/reports/*
# Recorded eval outputs committed on purpose: they are the reference data
# for the llm-eval-harness port validation (see both projects' READMEs).
# (The directory itself must be re-included first: git won't re-include
# files inside a directory that a higher-up rule excludes.)
!reports/auto_eval/
!reports/auto_eval/raw_outputs.jsonl
!reports/auto_eval/graded.jsonl
!reports/auto_eval/judge_scores.jsonl

# Local secrets and misc
.env
.env.*
!.env.example
.ipynb_checkpoints/

# One-shot session ops (tied to a specific pod + local machine; not reproducible
# project code) - watcher/teardown automation, run logs, probe scripts, handoff doc
logs/
RESUME.md
scripts/watch_eval.ps1
scripts/teardown_backup.ps1
scripts/_*.py
