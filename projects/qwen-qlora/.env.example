# Copy to .env (git-ignored) and fill in for dataset generation.
#
# Works with any OpenAI-compatible API: OpenAI, OpenRouter, Groq, or a local
# runtime (Ollama, vLLM, llama.cpp) - just point OPENAI_BASE_URL at it.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: extra HTTP headers for private gateways, semicolon-separated
# (e.g. OPENAI_EXTRA_HEADERS=x-custom-auth=...)
OPENAI_EXTRA_HEADERS=
